{
  "app": "liara-docs-bot",
  "type": "app",
  "platform": "node",
  "port": 3000,
  "dockerfile": "apps/web/Dockerfile",
  "env": {
    "LLM_API_KEY": "@liara-docs-bot/llm-api-key",
    "LLM_FALLBACK_API_KEY": "@liara-docs-bot/llm-fallback-api-key",
    "SESSION_SECRET": "@liara-docs-bot/session-secret",
    "EMBEDDING_API_KEY": "@liara-docs-bot/embedding-api-key",
    "LIARA_API_TOKEN": "@liara-docs-bot/liara-api-token",
    "EMBEDDING_TYPE": "api",
    "EMBEDDING_API_BASE": "https://api.avalai.ir/v1",
    "EMBEDDING_API_MODEL": "text-embedding-3-large"
  },
  "healthcheck": {
    "path": "/api/health",
    "port": 3000,
    "timeout": 10,
    "interval": 30,
    "retries": 3
  }
}
