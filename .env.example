# Liara Docs Bot Environment Variables
# Copy to .env and fill in real values. NEVER commit .env (FR-027, SC-017).
#   cp .env.example .env

# ============================================================================
# LLM Provider — primary (chat completions, OpenAI-compatible)
# ============================================================================
LLM_API_KEY=your_primary_api_key_here
LLM_API_BASE=https://api.kilo.ai/api/gateway
LLM_MODEL=kilo-auto/free

# ============================================================================
# LLM Provider — fallback, used when primary fails (FR-034, SC-025)
# Example: AvalAI, OpenAI-compatible — https://docs.avalai.ir/fa/quickstart
# ============================================================================
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_BASE=https://api.avalai.ir/v1
LLM_FALLBACK_MODEL=gpt-4o-mini

# ============================================================================
# Embeddings (FR-015)
#   local -> llama-server + bge-m3 gguf (free, no key, 1024 dims)
#   api   -> any OpenAI-compatible /v1/embeddings
# The runtime MUST use the same model that built the live index, otherwise
# query vectors are not comparable with stored ones.
# ============================================================================
EMBEDDING_TYPE=local

# local
EMBEDDING_MODEL_PATH=/path/to/bge-m3-Q4_K_M.gguf
LLAMA_SERVER_URL=http://127.0.0.1:8089

# api — AvalAI (OpenAI proxy) or Liara AI (https://ai.liara.ir/api/v1/<service-id>)
# Base URL may carry the trailing /v1; the client normalizes it.
EMBEDDING_API_BASE=https://api.avalai.ir/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-large
EMBEDDING_BATCH_SIZE=8

# ============================================================================
# Liara platform (deploy token — not used at runtime)
# ============================================================================
LIARA_API_TOKEN=
LIARA_APP_NAME=liara-docs-bot

# ============================================================================
# Session (stateless JWT — FR-031). Must be identical across instances.
# ============================================================================
SESSION_SECRET=generate_a_long_random_string
TOKEN_BUDGET=8000

# ============================================================================
# Vector index (versioned collections + `current` pointer — FR-032)
# ============================================================================
CHROMA_DB_PATH=./data/index
CHROMA_DB_COLLECTION=liara-docs
# Set to use a ChromaDB HTTP server instead of the committed file artifact.
CHROMA_DB_HOST=

# ============================================================================
# Retrieval / chunking
# ============================================================================
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CLARIFY_ENABLED=true

# ============================================================================
# Cache / rate limiting (FR-024, FR-026)
# ============================================================================
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=200
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ============================================================================
# Server / metrics
# ============================================================================
PORT=3000
NODE_ENV=production
METRICS_LOG_PATH=./data/logs/metrics.jsonl

# ============================================================================
# Support escalation (conversation-flow)
# ============================================================================
# Consecutive unhelpful outcomes (👎 feedback or duplicate re-asks) before the
# bot appends a support referral. 0 disables escalation.
ESCALATION_THRESHOLD=2
# Ticket page linked in the referral. Leave empty to omit the link entirely.
SUPPORT_TICKET_URL=
